# Google sign-in. Generate AUTH_SECRET with: openssl rand -hex 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# true uses deterministic demo responses with zero Qwen calls.
AI_DEMO_MODE=true

# Live AI. Set AI_DEMO_MODE=false, configure these, and apply the Supabase migrations.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-flash
QWEN_REPAIR_MODEL=
QWEN_ACCOUNT_DAILY_LIMIT=12
QWEN_SITE_DAILY_LIMIT=120

# Supabase. The URL is required for live AI. The publishable key enables records and uploads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Required for live AI usage limits.
SUPABASE_SERVICE_ROLE_KEY=
